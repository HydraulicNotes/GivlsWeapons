Mods: {
	GivlsWeapons: {
		Buffs: {
			InstaKillCurse: {
				DisplayName: Curse of Sudden Death
				Description: One hit will kill you!
			}
		}

		Items: {
			DiscordShield: {
				DisplayName: Shield of Discord
				Tooltip:
					'''
					Double tap to dash into the enemy, doing extra damage if the enemy has Chaos State.
					Teleport to the mouse cursor when you hit with the dash, and inflict the enemy with Chaos State
					'''
			}

			MeteorDisk: {
				DisplayName: Meteor Charm
				Tooltip:
					'''
					Creates a burning aura beneath you that restores mana when it damages enemies
					"Fire, walk with me"
					'''
			}

			QuicksilverBoots: {
				DisplayName: Quicksilver Boots
				Tooltip:
					'''
					The wearer can run super fast
					Running fast restores mana
					'''
			}

			BlackandWhiteGun: {
				DisplayName: Black & White
				Tooltip: Every sixth shot fires a dao which explodes when shot into homing black & white bullets
			}

			BoringWand: {
				DisplayName: Pentacle Staff
				Tooltip:
					'''
					Shoots a pentacle that reflects back and forth.
					Every hit gives the pentacle a small amount of healing energy, which will be given to you on contact
					'''
			}

			Cross: {
				DisplayName: Cross
				Tooltip:
					'''
					Continuously damages enemies in front of you
					Cannot move while holding up
					'''
			}

			HFMuramasa: {
				DisplayName: High-Frequency Muramasa
				Tooltip:
					'''
					15 armor penetration
					Creates an additional slash on hit, to cut enemies twice
					Stop moving to sheath the sword, the next attack will be an explosive quick-draw
					'''
			}

			RubberKnife: {
				DisplayName: Rubber Knife
				Tooltip: Krav Maga!
			}

			TeleportingAxes: {
				DisplayName: Tesseraxes
				Tooltip:
					'''
					Use the left and right mouse buttons to attack with either axe.
					Throw the axe by using it after striking an enemy, and use again to teleport to it.
					'''
			}

			RisingFlameArrow: {
				DisplayName: Rising Flame Arrow
				Tooltip: Fires a rising flame upwards on impact
			}

			CursedFlask: {
				DisplayName: Cursed Flask
				Tooltip:
					'''
					Restores you to full life and does not cause potion sickness
					Inflicts a curse which causes you to die in one hit for a base of 20 seconds
					Not consumable, and will not be used when quick healing
					'''
			}

			ChlorophyteIdol: {
				DisplayName: Chlorophyte Idol
				Tooltip: True melee hits create a stationary leaf crystal that fires at nearby enemies
			}

			BreakerBullet: {
				DisplayName: Breaker Bullet
				Tooltip:
					'''
					Weakens enemy projectiles until they are destroyed
					Inflicts Shadowflame
					'''
			}

			TeslaDaggers: {
				Tooltip: Throws two embedding daggers connected by an arc of lightning
				DisplayName: Tesla Daggers
			}
		}

		Projectiles: {
			MeteorDiskAura.DisplayName: Meteor Charm Aura
			BoringWandProjectile.DisplayName: Pentacle
			CrossAura.DisplayName: Cross
			HFMuramasaProjectile.DisplayName: High-Frequency Muramasa
			RubberKnifeProjectile.DisplayName: Rubber Knife
			HFMuramasaGlowingSlash.DisplayName: High-Frequency Muramasa
			TeleportingAxeProjectile.DisplayName: Tesseraxe
			TeleportingAxeSwingProjectile.DisplayName: Tesseraxe
			RisingFlameArrowProjectile.DisplayName: Rising Flame Arrow
			RisingFlameProjectile.DisplayName: Rising Flame
			Pentacle.DisplayName: Pentacle
			AltLeafCrystal.DisplayName: Crystal Leaf
			BreakerBulletProjectile.DisplayName: Breaker Bullet
			TeslaDagger.DisplayName: Tesla Dagger
			TeslaArc.DisplayName: Tesla Arc
			YinYang.DisplayName: Yin Yang
			YinYangBullet.DisplayName: Yin Yang Bullet
		}

		Configs: {
			BuffConfig: {
				DisplayName: Buffs
				Headers.Debuffs: Debuffs

				ChaosStateAffectsNPCs: {
					Label: Chaos State affects NPCs
					Tooltip:
						'''
						Whether Chaos State should damage NPCs when teleporting and emit dust particles.
						Disable if this effect overlaps with another mod, or is affecting enemies it shouldn't
						Otherwise, leave it on unless you *really* want it off
						'''
				}

				ShadowflameAffectsPlayers: {
					Label: Shadowflame affects players
					Tooltip:
						'''
						Whether Shadowflame should damage players and emit dust particles
						Disable if this effect overlaps with another mod or misbehaves
						Otherwise, leave it on unless you really want it off
						'''
				}
			}
		}
	}
}
